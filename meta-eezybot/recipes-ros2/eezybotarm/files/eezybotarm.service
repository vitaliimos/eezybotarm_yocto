[Unit]
Description=EezyBotArm ROS 2 launch
After=network.target

[Service]
Type=simple
Environment=HOME=/root
Environment=ROS_HOME=/root/.ros
Environment=EEZYBOTARM_LAUNCH=jetson.launch.py
Environment=EEZYBOTARM_ARGS=
EnvironmentFile=-/etc/default/eezybotarm
# Ensure TensorRT engine exists before starting
ExecStartPre=-/usr/bin/eezybotarm-ensure-engine.sh
ExecStart=/bin/sh -c '. /opt/ros/jazzy/setup.sh && exec ros2 launch eezybotarm_moveit_config "$EEZYBOTARM_LAUNCH" $EEZYBOTARM_ARGS'
Restart=on-failure
RestartSec=10
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
