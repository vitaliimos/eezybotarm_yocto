[Unit]
Description=EezyBotArm ROS 2 launch
After=network.target

[Service]
Type=simple
# Defaults for the production image (headless, real hardware). The dev image
# overrides these through /etc/default/eezybotarm - see the
Environment=HOME=/root
Environment=ROS_HOME=/root/.ros
Environment=EEZYBOTARM_LAUNCH=production.launch.py
Environment=EEZYBOTARM_USE_RVIZ=0
Environment=EEZYBOTARM_ARGS=
EnvironmentFile=-/etc/default/eezybotarm
# production.launch.py ignores the (undeclared) use_rviz argument; dev.launch.py
# uses it to toggle RViz.
ExecStart=/bin/sh -c '. /opt/ros/jazzy/setup.sh && exec ros2 launch eezybotarm_moveit_config "$EEZYBOTARM_LAUNCH" use_rviz:="$EEZYBOTARM_USE_RVIZ" $EEZYBOTARM_ARGS'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target