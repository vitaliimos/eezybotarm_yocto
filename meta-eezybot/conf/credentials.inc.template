# Copy this file to meta-eezybot/conf/credentials.inc
# It is excluded by .gitignore and will not be committed to Git.
#
# All secrets consumed by the EezyBot images live here. Without this file the
# build still succeeds, but the image boots with no SSH public key (no network
# login), no VNC password and no Wi-Fi configuration.
#
# Values can be set with '?=' weak assignment overrides (kas local_conf_header
# or an OS environment via kas' 'env:' mapping) instead of editing this file.

# --- Wi-Fi ---------------------------------------------------------------
# Writes /etc/wpa_supplicant/wpa_supplicant-wlan0.conf and
# /usr/lib/systemd/network/25-wireless.network in the image postprocess; the
# stock wpa_supplicant@wlan0.service (enabled in the distro) + systemd-networkd
# handle the rest. Leave the SSID empty to skip Wi-Fi configuration.
EEZYBOT_WIFI_SSID = ""
EEZYBOT_WIFI_PASSWORD = ""

# --- root password (VNC only) --------------------------------------------
# Plaintext password used *only* by the dev image's VNC desktop (its first 8
# characters, per the VNC protocol; baked into /etc/x11vnc.passwd at build
# time). It is never written into /etc/shadow: SSH is key-only, so there is no
# password login to configure on the production image.
EEZYBOT_ROOT_PASSWORD = "eezybot"

# --- SSH public keys (the only way to log in over the network) ------------
# Public key(s) installed to /root/.ssh/authorized_keys. SSH is key-only -
# OpenSSH's default PermitRootLogin=prohibit-password is kept, so this is the
# only way to log in remotely. Separate multiple keys with "\n".
EEZYBOT_SSH_PUBLIC_KEYS = ""
